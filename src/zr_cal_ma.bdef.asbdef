managed implementation in class zbp_r_cal_ma unique;
strict ( 2 );

extensible
{
with validations on save;
}


define behavior for ZR_CAL_MA alias CalibrationRequest
persistent table zcal_ma
lock master
authorization master ( none )
etag master LocalLastChangedAt

extensible
{
  create;
  update;
  delete;
  field (numbering : managed, readonly ) Uuid;
  field (readonly) LocalLastChangedAt;

  mapping for zcal_ma corresponding extensible
  {

    Uuid                = uuid;
    InstrumentCode      = instrument_code;
    ResultCode          = result_code;
    CalibrationNote     = calibration_note;
    LocalLastChangedAt  =  local_last_changed_at;
  }

}