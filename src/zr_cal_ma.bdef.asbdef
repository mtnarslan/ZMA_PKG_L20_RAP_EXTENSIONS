managed implementation in class zbp_r_cal_ma unique;
strict ( 2 );
with draft;
extensible
{
with validations on save;
}


define behavior for ZR_CAL_MA alias CalibrationRequest
persistent table zcal_ma
draft table zdcal_ma
lock master
total etag LastChangedAt
authorization master ( none )
etag master LocalLastChangedAt

extensible
{
  create;
  update;
  delete;
  field (numbering : managed, readonly ) Uuid;
  field (readonly)

  ResponsibleUser,
  LocalLastChangedAt,
  LastChangedAt;

  draft action Edit;
  draft action Activate optimized;
  draft action Discard;
  draft action Resume;


  determination setResponsibleUser on modify { create;}

  draft determine action Prepare extensible;



  mapping for zcal_ma corresponding extensible
  {

    Uuid                = uuid;
    InstrumentCode      = instrument_code;
    ResultCode          = result_code;
    CalibrationNote     = calibration_note;
    ResponsibleUser     = responsible_user;
    LocalLastChangedAt  = local_last_changed_at;
    LastChangedAt       = last_changed_at;

  }

}